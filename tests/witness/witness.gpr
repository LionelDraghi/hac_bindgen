with "hac";

project Witness is

   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "../../obj/witness";
   for Exec_Dir use "../../bin";
   for Main use ("witness_main.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatf",
         "-gnatyabefhiklnprtx");
   end Compiler;

end Witness;
