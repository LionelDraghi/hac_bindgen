   for Source_Dirs use (".", "../kazakov");
   for Main use ("binding_probe.adb");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
end Binding_Probe;
