--  hac_bindgen: binding generator for embedded HAC.
--  Development profile: run-time checks on, warnings are errors.
project Hac_Bindgen is

   type Build_Profile_Kind is ("release", "development");
   Build_Profile : Build_Profile_Kind :=
     External ("Hac_Bindgen_Build_Profile", "development");

   for Languages use ("Ada");
   for Source_Dirs use ("src", "src/Alire_config");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("hac_bindgen-main.adb");

   package Builder is
      for Executable ("hac_bindgen-main.adb") use "hac-bindgen";
   end Builder;

   Base_Switches := ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatf",
                     "-gnatyabefhiklnprtx");
   --  Style checking :
   --  a : Check attribute casing
   --  b : Blanks not allowed at statement end
   --  e : Check end/exit labels
   --  f : No form feeds or vertical tabs
   --  h : No horizontal tabs
   --  i : Check if-then layout
   --  k : Check keyword casing
   --  l : Check layout
   --  n : Check casing of entities in Standard
   --  p : Check pragma casing
   --  r : Check references
   --  t : Check token spacing
   --  x : Check extra parentheses
   --  No maximum line length: GNATformat (width 100) owns the layout.

   package Compiler is
      case Build_Profile is
         when "release" =>
            for Default_Switches ("Ada") use Base_Switches & ("-O2");
         when others =>
            for Default_Switches ("Ada") use Base_Switches & ("-gnatVa", "-gnata");
      end case;
   end Compiler;

   package Format is
      for Indentation ("Ada") use "3";
      for Indentation_Continuation ("Ada") use "3";
      for Width ("Ada") use "100";
   end Format;

end Hac_Bindgen;
