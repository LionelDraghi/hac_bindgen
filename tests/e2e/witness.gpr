with "hac";

--  End-to-end test harness project (A002): the scenarios put the
--  per-scenario files (API fixture, generated files, script, renames)
--  in ../run — the run directory of bbt is the parent (tests/) — and
--  this project compiles them together with the static witness main.
--  All artefacts stay inside ../run, which the bbt cleanup removes.

project Witness is

   for Languages use ("Ada");
   for Source_Dirs use ("../run", ".");
   for Object_Dir use "../run/obj";
   for Exec_Dir use "../run";
   for Main use ("witness_main.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatf",
         "-gnatyabefhiklnprtx");
   end Compiler;

end Witness;
