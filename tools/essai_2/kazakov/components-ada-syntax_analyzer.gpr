          "parsers-ada_syntax_analyzer-get_protected.adb",
          "parsers-ada_syntax_analyzer-get_separate.adb",
          "parsers-ada_syntax_analyzer-get_sequence.adb",
          "parsers-ada_syntax_analyzer-get_sequence-get_accept.adb",
          "parsers-ada_syntax_analyzer-get_sequence-get_call.adb",
          "parsers-ada_syntax_analyzer-get_sequence-get_case.adb",
          "parsers-ada_syntax_analyzer-get_sequence-get_declare.adb",
          "parsers-ada_syntax_analyzer-get_sequence-get_delay.adb",
