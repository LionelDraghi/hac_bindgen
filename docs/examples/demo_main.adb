--  The embedding application: registers the binding generated by
--  hac-bindgen, then hands the HAC VM any script passed on the
--  command line.
--
--  HAC resolves the units a script `with`es by file name, relative to
--  the current directory: run this demo from the directory holding
--  the generated facade (generated_src/).
--
--    cd generated_src
--    ../demo ../demo.hac

with Ada.Command_Line;
with Ada.Text_IO;
with Geometry_Native;
with HAC_Sys.Builder;
with HAC_Sys.PCode.Interpreter;

procedure Demo_Main is

   use Ada.Text_IO;
   use HAC_Sys.PCode.Interpreter;

   BD          : HAC_Sys.Builder.Build_Data;
   Post_Mortem : Post_Mortem_Data;

begin
   if Ada.Command_Line.Argument_Count /= 1 then
      Put_Line (Current_Error, "usage: demo script.hac");
      Ada.Command_Line.Set_Exit_Status (Ada.Command_Line.Failure);
      return;
   end if;

   Geometry_Native.Register_All (BD);

   declare
      Script : constant String := Ada.Command_Line.Argument (1);
   begin
      BD.Build_Main_from_File (Script);
      if not BD.Build_Successful then
         Put_Line (Current_Error, "HAC failed to build " & Script);
         Ada.Command_Line.Set_Exit_Status (Ada.Command_Line.Failure);
         return;
      end if;

      Interpret_on_Current_IO (BD, 0, Script, Post_Mortem);

      if Is_Exception_Raised (Post_Mortem.Unhandled) then
         Put_Line (Current_Error,
                   "HAC VM exception: " & Message (Post_Mortem.Unhandled));
         Ada.Command_Line.Set_Exit_Status (Ada.Command_Line.Failure);
      end if;
   end;
end Demo_Main;
