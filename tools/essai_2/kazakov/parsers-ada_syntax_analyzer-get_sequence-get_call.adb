separate (Parsers.Ada_Syntax_Analyzer.Get_Sequence)
   function Get_Call (Expression : Tokens.Argument_Token)
      return Call_Statement_Ptr is
   type Arena_Ptr is access Call_Statement;
   for Arena_Ptr'Storage_Pool use Context.Pool.all;
   Ptr  : constant Arena_Ptr := new Call_Statement (Labels_Count);
   This : Call_Statement renames Ptr.all;
begin
   This.Target   := Expression;
   This.Location := Expression.Location;
   This.Path.Position := 1;
   Pop (Context, Parent, File, This, This.Labels);
   return This'Unchecked_Access;
end Get_Call;
